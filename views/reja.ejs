<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>REJA</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />

  <style>
    body {
      background:
        radial-gradient(circle at top, rgba(255,0,120,.15), transparent 30%),
        radial-gradient(circle at bottom, rgba(0,255,255,.12), transparent 40%),
        #050505;

      color: #fff;
      font-family: monospace;
      overflow-x: hidden;
      min-height: 100vh;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;

      background:
        repeating-linear-gradient(
          90deg,
          transparent 0 80px,
          rgba(0,255,255,.06) 80px 82px
        ),
        repeating-linear-gradient(
          180deg,
          transparent 0 60px,
          rgba(255,0,128,.05) 60px 62px
        );

      animation: driftMove 8s linear infinite;
      pointer-events: none;
    }

    @keyframes driftMove {
      from {
        transform: translateY(0);
      }

      to {
        transform: translateY(120px);
      }
    }

    h1 {
      color: #00ffff;
      letter-spacing: 6px;

      text-shadow:
        0 0 5px #00ffff,
        0 0 15px #00ffff,
        0 0 30px #ff0080;

      animation: neonPulse 2s infinite alternate;
    }

    @keyframes neonPulse {
      from {
        opacity: .7;
      }

      to {
        opacity: 1;

        text-shadow:
          0 0 10px #00ffff,
          0 0 30px #00ffff,
          0 0 60px #ff0080;
      }
    }

    .jumbotron {
      background: rgba(15,15,15,.7);

      border: 1px solid rgba(0,255,255,.2);

      border-radius: 25px;

      backdrop-filter: blur(12px);

      box-shadow:
        0 0 20px rgba(0,255,255,.15),
        0 0 40px rgba(255,0,128,.08);

      transition: .4s;
    }

    .jumbotron:hover {
      transform: translateY(-2px);

      box-shadow:
        0 0 30px rgba(0,255,255,.25),
        0 0 50px rgba(255,0,128,.15);
    }

    #create-field {
      background: rgba(0,0,0,.75);

      border: 1px solid #00ffff;

      color: #00ffff;

      border-radius: 20px;

      transition: .3s;
    }

    #create-field:focus {
      background: rgba(0,0,0,.9);

      color: #fff;

      border-color: #ff00aa;

      box-shadow:
        0 0 10px #00ffff,
        0 0 25px #ff00aa;

      transform: scale(1.01);
    }

    button {
      border: none !important;

      transition: .35s;

      position: relative;

      overflow: hidden;

      font-weight: bold;
    }

    .btn-primary {
      background:
        linear-gradient(45deg,#00ffff,#0066ff);

      box-shadow:
        0 0 10px #00ffff,
        0 0 20px #0066ff;
    }

    .btn-secondary {
      background:
        linear-gradient(45deg,#8f00ff,#ff00aa);

      box-shadow:
        0 0 10px #ff00aa,
        0 0 20px #8f00ff;
    }

    .btn-danger {
      background:
        linear-gradient(45deg,#ff003c,#ff6600);

      box-shadow:
        0 0 10px #ff003c,
        0 0 20px #ff6600;
    }

    button:hover {
      transform:
        translateY(-3px)
        scale(1.05);

      filter: brightness(1.15);
    }

    button::before {
      content: "";

      position: absolute;

      top: 0;
      left: -120%;

      width: 80px;
      height: 100%;

      background: rgba(255,255,255,.35);

      transform: skewX(-20deg);
    }

    button:hover::before {
      animation: swipe .8s linear;
    }

    @keyframes swipe {
      from {
        left: -120%;
      }

      to {
        left: 150%;
      }
    }

    .list-group-item {
      background: rgba(10,10,10,.75) !important;

      color: #fff !important;

      border:
        1px solid rgba(0,255,255,.18) !important;

      margin-top: 12px;

      border-radius: 18px !important;

      backdrop-filter: blur(8px);

      transition: .35s;

      box-shadow:
        0 0 12px rgba(0,255,255,.08);
    }

    .list-group-item:hover {
      transform:
        translateX(8px)
        scale(1.01);

      border-color: #ff00aa !important;

      box-shadow:
        0 0 20px rgba(255,0,170,.25),
        0 0 40px rgba(0,255,255,.15);
    }

    .item-text {
      text-shadow:
        0 0 6px rgba(0,255,255,.6);
    }

    #clean-all {
      margin-top: 20px;
    }

    .container::after {
      content: "";

      position: fixed;

      bottom: -150px;
      left: 50%;

      width: 900px;
      height: 300px;

      transform: translateX(-50%);

      background:
        radial-gradient(circle,
        rgba(0,255,255,.2),
        transparent 70%);

      filter: blur(60px);

      z-index: -1;

      animation: cityGlow 4s ease-in-out infinite alternate;
    }

    @keyframes cityGlow {
      from {
        opacity: .5;
        transform:
          translateX(-50%)
          scale(1);
      }

      to {
        opacity: 1;
        transform:
          translateX(-50%)
          scale(1.08);
      }
    }

    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: #050505;
    }

    ::-webkit-scrollbar-thumb {
      background:
        linear-gradient(#00ffff,#ff0080);

      border-radius: 20px;
    }

    .hacker-emoji {
      position: fixed;
      top: -50px;
      font-size: 18px;
      opacity: .8;
      animation: fall linear infinite;
      z-index: 1;
      pointer-events: none;
    }

    @keyframes fall {
      to {
        transform: translateY(110vh);
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <h1 class="display-4 text-center py-1">
      REJA VA MAQSADLAR
    </h1>

    <div class="jumbotron p-3 shadow-sm">
      <form id="create-form" action="/create-item" method="POST">
        <div class="d-flex align-items-center">
          <input
            type="text"
            id="create-field"
            name="reja"
            autofocus
            autocomplete="off"
            class="form-control mr-3"
            style="flex: 1"
          />

          <button
            class="btn btn-primary"
            style="border-radius: 20px"
          >
            Yangi Reja Qo'shish
          </button>
        </div>
      </form>
    </div>

    <ul id="item-list" class="list-group pb-5">
      <% items.map(function(item) { %>

      <li
        class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
      >
        <span class="item-text">
          <%= item.reja %>
        </span>

        <div>
          <button
            data-id="<%= item._id %>"
            class="edit-me btn btn-secondary btn-sm mr-1"
          >
            O'zgartirish
          </button>

          <button
            data-id="<%= item._id %>"
            class="delete-me btn btn-danger btn-sm"
          >
            O'chirish
          </button>
        </div>
      </li>

      <% }) %>
    </ul>

    <button
      id="clean-all"
      class="btn btn-danger"
      style="border-radius: 20px"
    >
      Barcha rejalarni o'chirish
    </button>
  </div>

  <div id="emoji-container"></div>

  <script>
    const emojis = [
      "🏎️",
      "🌃",
      "💻",
      "🧠",
      "⚡",
      "🕶️",
      "👾",
      "📡",
      "🔥"
    ]

    const container =
      document.getElementById("emoji-container")

    for (let i = 0; i < 18; i++) {

      const el =
        document.createElement("span")

      el.className =
        "hacker-emoji"

      el.innerText =
        emojis[
          Math.floor(
            Math.random() * emojis.length
          )
        ]

      el.style.left =
        Math.random() * 100 + "vw"

      el.style.animationDuration =
        (5 + Math.random() * 8) + "s"

      container.appendChild(el)
    }
  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.2.1/axios.min.js"></script>

  <script src="/browser.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>REJA</title>

  <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
    rel="stylesheet" 
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
    crossorigin="anonymous"
  >

  <style>
    body {
      background: #000;
      color: #00ff9f;
      font-family: monospace;
      overflow-x: hidden;
    }

    body::before {
      content: "010101010101010101010101010101010101010101010101";
      position: fixed;
      top: 0;
      left: 0;
      width: 200%;
      height: 200%;
      font-size: 14px;
      color: rgba(0,255,100,0.07);
      white-space: pre;
      animation: matrixMove 8s linear infinite;
      pointer-events: none;
    }

    @keyframes matrixMove {
      from { transform: translateY(0); }
      to { transform: translateY(-50%); }
    }

    .hacker-emoji {
      position: fixed;
      top: -50px;
      font-size: 18px;
      opacity: 2;
      animation: fall linear infinite;
    }

    @keyframes fall {
      to {
        transform: translateY(110vh);
      }
    }
  </style>
</head>

<body>
    <div class="container">
        <h1 class="display-4 text-center py-1"> REJA VA MAQSADLAR</h1>

        <div class="jumbotron p-3 shadow-sm">
            <form id="create-form" action="/create-item" method="POST">
                <div class="d-flex align-items-center">
                    <input
                     type="text"
                     id="create-field"
                     name="reja"
                     autofocus
                     autocomplete="off"
                     class="form-control mr-3"
                     style="flex: 1"
                     />
                     
                     <button class="btn btn-primary" style="border-radius: 20px">
                        Yangi Reja Qo'shish
                     </button>
                </div>
            </form>
        </div>

      <ul id="item-list" class="list-group pb-5">
         <% items.map (function (item) { %>
        <li
        class="list-group-item list-group-item-info d-flex align-items-center justify-content-between" 
        >
      <span class="item-text"><%=item.reja%></span>
      <div>
        <button 
        data-id="<%=item._id%>"
        class="edit-me btn btn-secondary btn-sm mr-1">
          O'zgartirish 
        </button>
        <button
        data-id="<%=item._id%>"
        class="delete-me btn btn-danger btn-sm">
        O'chirish
      </button>
      </div>
      </li>
      <% }) %> 
      </ul>
        <button id="clean-all" class="btn btn-danger" style="border-radius: 20px">
            Barcha rejalarni o'chirish
        </button>
    </div>

    <div id="emoji-container"></div>
    <script>
      const emojis = ["💻","🧠","🔐","⚠️","📡","🕶️","","👾","🧑‍💻"];
      const container = document.getElementById("emoji-container");

      for (let i = 0; i < 15; i++) {
        const el = document.createElement("span");
        el.className = "hacker-emoji";
        el.innerText = emojis[Math.floor(Math.random() * emojis.length)];

        el.style.left = Math.random() * 100 + "vw";
        el.style.animationDuration = (5 + Math.random() * 10) + "s";

        container.appendChild(el);
      }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.2.1/axios.min.js"></script>
    <script src="/browser.js"></script>
</body>
</html>